# --- LLM ---
LLM_PROVIDER=azure_openai            # azure_openai | openai | anthropic
LLM_MODEL=                           # strongest tool-calling model/deployment available
LLM_MODEL_FAST=                      # optional cheaper model for extraction, fact rewriting, injection checks
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Runtime ---
KARYA_COMPANY_DIR=company
KARYA_DB_PATH=data/karya.db
KARYA_RUNS_DIR=runs
KARYA_HEADLESS=1                     # set 0 to watch the browser (demo video)
KARYA_MAX_STEPS=60
KARYA_MAX_STEPS_BATCH=150
KARYA_TASK_TOKEN_BUDGET=800000
KARYA_TASK_WALLCLOCK_MIN=25
KARYA_SNAPSHOT_CHARS=8000
KARYA_HISTORY_FULL_STEPS=6

# --- Sandbox credentials (seeded into sandbox apps; injected by tools; never shown to the model) ---
SANDBOX_ADMIN_TOKEN=change-me-admin
ERP_AGENT_USER=karya.agent
ERP_AGENT_PASSWORD=change-me-erp
ERP_API_KEY=change-me-erp-api
MAIL_AGENT_USER=karya.agent
MAIL_AGENT_PASSWORD=change-me-mail
MAIL_API_KEY=change-me-mail-api
HR_AGENT_USER=karya.agent
HR_AGENT_PASSWORD=change-me-hr
HR_API_KEY=change-me-hr-api
